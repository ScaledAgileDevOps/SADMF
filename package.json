{
  "name": "SADMF",
  "version": "3.0.63",
  "description": "Scaled Agile DevOps Maturity Framework",
  "keywords": [
    "agile"
  ],
  "homepage": "https://scaledagiledevops.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScaledAgileDevOps/SADMF.git"
  },
  "license": "CC-BY-4.0",
  "author": "Bran Finster",
  "main": "hugo serve",
  "scripts": {
    "badges": "node scripts/generate-badge-pngs.js",
    "build": "hugo",
    "build:clean": "rm -rf public && npm run build",
    "link-check": "npm run build:clean && linkinator ./public",
    "link-check2": "npm run build:clean && htmltest",
    "lint": "markdownlint ./content/**/*.md",
    "lint:fix": "markdownlint -f ./content/**/*.md",
    "start": "hugo serve",
    "test": "npm run lint && npm run link-check",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test --reporter=html",
    "update": "hugo mod get -u ./... && hugo mod tidy && npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.5.4",
    "linkinator": "^8.1.0",
    "markdownlint-cli": "^0.49.1",
    "openai": "^7.9.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1"
  },
  "overrides": {
    "js-yaml": "^5.0.0",
    "markdown-it": "^14.2.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
